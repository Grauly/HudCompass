{
  "schemaVersion": 1,
  "id": "hudcompass",
  "version": "${version}",

  "name": "Hud Compass",
  "description": "Displays a compass on hud",
  "authors": [
    "Grauly"
  ],
  "contact": {
    "homepage": "",
    "sources": "https://github.com/Grauly/HudCompass?"
  },

  "license": "MIT",
  "icon": "assets/hudcompass/icon.png",

  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "value": "grauly.hudcompass.HudCompassClient",
        "adapter": "kotlin"
      }
    ],
    "fabric-datagen": [
      {
        "value": "grauly.hudcompass.HudCompassDatagen",
        "adapter": "kotlin"
      }
    ]
  },
  "mixins": [
    "hudcompass.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "~1.21",
    "java": "21"
  }
}
