{
  "schemaVersion": 1,
  "id": "hudcompass",
  "version": "${version}",

  "name": "Hud Compass",
  "description": "Displays a compass on hud",
  "authors": [
    "Grauly"
  ],
  "contact": {
    "homepage": "",
    "sources": "https://github.com/Grauly/HudCompass?"
  },

  "license": "MIT",
  "icon": "assets/hudcompass/icon.png",

  "environment": "client",
  "entrypoints": {
